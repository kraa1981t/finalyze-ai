{
  "entities": {
    "AnalysisResult": {
      "title": "Analysis Result",
      "description": "Historical analysis result generated by the AI.",
      "type": "object",
      "properties": {
        "symbol": { "type": "string" },
        "type": { "type": "string", "enum": ["forex", "crypto", "stocks", "metals"] },
        "timeframe": { "type": "string" },
        "signal": { "type": "string", "enum": ["strong_buy", "buy", "neutral", "sell", "strong_sell"] },
        "summary": { "type": "string" },
        "technicalScore": { "type": "number" },
        "sentimentScore": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" }
      },
      "required": ["symbol", "type", "timeframe", "signal", "summary", "timestamp", "userId"]
    },
    "UserPreference": {
      "title": "User Preference",
      "description": "User's saved settings and watchlists.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "watchlist": { "type": "array" },
        "theme": { "type": "string", "enum": ["light", "dark"] }
      },
      "required": ["userId"]
    }
  },
  "firestore": {
    "/analysisResults/{resultId}": {
      "schema": "AnalysisResult",
      "description": "Collection of analysis results."
    },
    "/userPreferences/{userId}": {
      "schema": "UserPreference",
      "description": "User specific preferences."
    }
  }
}
