# GROQ_API_KEY: Your Groq API Key from https://console.groq.com/keys
GROQ_API_KEY=""

# GROQ_MODEL: The model to use (llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768)
GROQ_MODEL="llama-3.3-70b-versatile"

# DEEPSEEK_API_KEY: DeepSeek API key for AI analysis (primary)
DEEPSEEK_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="https://finalyze-ai-sigma.vercel.app"

# VERCEL_DEPLOY_HOOK_URL: Optional. Factory Reset hook from Vercel Dashboard → Deploy Hooks
VERCEL_DEPLOY_HOOK_URL=""

# GITHUB_PAT: Optional. GitHub Personal Access Token for factory-reset workflow dispatch
GITHUB_PAT=""
