rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // Clients collection — allow read/write for registration and verification
    match /clients/{clientId} {
      allow read, write: if true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return (isSignedIn() && request.auth.uid == userId) || userId != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /analysisResults/{resultId} {
      allow read, write: if true;
    }

    match /userPreferences/{userId} {
      allow read, write: if true;
    }

    // Shared results — anyone can read/write (clients may be anonymous)
    match /shared_results/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Shared alerts — anyone can read/write
    match /shared_alerts/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Shared radar status — developer writes running state, clients read to show banner
    match /shared_status/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Shared settings (freemium state, client login toggle) — anyone can read/write
    match /shared_settings/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Site ads config — developer writes, anyone reads
    match /config/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Suggestions — anyone can read/write
    match /suggestions/{suggestionId} {
      allow read, write: if true;
    }

    // Analytics — anyone can read/write (for anonymous tracking)
    match /analytics_counters/{docId} {
      allow read, write: if true;
    }

    match /analytics_views/{docId} {
      allow read, write: if true;
    }

    match /analytics_clicks/{docId} {
      allow read, write: if true;
    }
  }
}
